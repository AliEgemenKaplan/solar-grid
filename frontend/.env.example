# Where the dashboard finds each service, as seen from the operator's browser.
#
# Everything prefixed VITE_ is compiled into the JavaScript the browser
# downloads and is readable by anyone who opens the page. Never put a token,
# a password or anything else secret here: the operator types their token
# into the sign-in form instead.
#
# The defaults are the ports docker-compose publishes on this machine, so
# `pnpm dev` works against the Docker stack without a .env at all.
VITE_SMART_METER_API_URL=http://localhost:3001
VITE_PRICING_API_URL=http://localhost:3002
VITE_TRADE_MATCHING_API_URL=http://localhost:3003
VITE_BILLING_API_URL=http://localhost:3004

# How long one request may take before the dashboard gives up on it.
VITE_REQUEST_TIMEOUT_MS=10000
# How often the dashboard refreshes itself while auto refresh is on.
VITE_AUTO_REFRESH_MS=30000
