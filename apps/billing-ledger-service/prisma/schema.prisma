datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// This service keeps the money, so nothing here is a Float. Amounts are
// Decimal(14, 2) - whole kurus - prices Decimal(10, 4) and energy
// Decimal(12, 3), and every sum is done by Postgres in exact arithmetic.

model CompletedTrade {
  id                String           @id @default(cuid())
  tradeId           String           @unique
  sellerHouseholdId String
  buyerHouseholdId  String
  energyKwh         Decimal          @db.Decimal(12, 3)
  pricePerKwh       Decimal          @db.Decimal(10, 4)
  totalAmount       Decimal          @db.Decimal(14, 2)
  currency          String
  idempotencyKey    String           @unique
  correlationId     String
  completedAt       DateTime
  createdAt         DateTime         @default(now())

  ledgerEntries     LedgerEntry[]
  idempotencyKeys   IdempotencyKey[]

  @@index([sellerHouseholdId])
  @@index([buyerHouseholdId])
  // Tracing one reading through to the ledger.
  @@index([correlationId])
  @@map("completed_trades")
}

model LedgerEntry {
  id            String         @id @default(cuid())
  tradeId       String
  householdId   String
  entryType     EntryType
  amount        Decimal        @db.Decimal(14, 2)
  currency      String
  correlationId String
  createdAt     DateTime       @default(now())

  trade         CompletedTrade @relation(fields: [tradeId], references: [tradeId])

  /// One side of a trade is credited or debited exactly once. Even if the
  /// application were asked to settle the same trade twice, the database
  /// refuses the second set of entries.
  @@unique([tradeId, householdId, entryType])
  // The ledger endpoint reads one household newest first.
  @@index([householdId, createdAt])
  @@index([tradeId])
  @@map("ledger_entries")
}

model HouseholdBalance {
  id          String   @id @default(cuid())
  householdId String   @unique
  balance     Decimal  @default(0) @db.Decimal(14, 2)
  currency    String   @default("TRY")
  updatedAt   DateTime @updatedAt

  @@map("household_balances")
}

model IdempotencyKey {
  id           String         @id @default(cuid())
  key          String         @unique
  tradeId      String
  /// SHA-256 of the canonical request. The same key with a different hash is
  /// a conflict, not a retry.
  requestHash  String?
  createdAt    DateTime       @default(now())

  trade        CompletedTrade @relation(fields: [tradeId], references: [tradeId])

  @@map("idempotency_keys")
}

enum EntryType {
  CREDIT
  DEBIT
}
