NODE_ENV=development
PORT=3004
# The database is not published to the host by the base compose file.
# To run this service locally against the containerised database, start
# the stack with infrastructure/docker-compose.dev-ports.yml as well.
#
# Connect as the runtime role, as the container does; its password is
# LEDGER_DB_PASSWORD in infrastructure/.env. Migrations need the owner instead:
#   DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5436/ledger_db pnpm prisma:deploy
DATABASE_URL=postgresql://solargrid_app:<LEDGER_DB_PASSWORD>@localhost:5436/ledger_db

# HTTP platform (see docs/api-security.md)
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
# Required by POST /trades. Must match what trade-matching sends.
INTERNAL_API_TOKEN=
# Required by GET /stats/* (see docs/analytics.md).
OPERATOR_API_TOKEN=

# How long a shutdown may wait for in-flight work before the process exits anyway.
SHUTDOWN_TIMEOUT_MS=25000

# Observability (see docs/observability.md). Readable lines locally; the Docker
# stack writes JSON.
LOG_FORMAT=pretty
LOG_LEVEL=log
# Required by GET /metrics.
METRICS_TOKEN=
