NODE_ENV=development
PORT=3001
# The database is not published to the host by the base compose file.
# To run this service locally against the containerised database, start
# the stack with infrastructure/docker-compose.dev-ports.yml as well.
#
# Connect as the runtime role, as the container does; its password is
# SMART_METER_DB_PASSWORD in infrastructure/.env. Migrations need the owner instead:
#   DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5433/smart_meter_db pnpm prisma:deploy
DATABASE_URL=postgresql://solargrid_app:<SMART_METER_DB_PASSWORD>@localhost:5433/smart_meter_db
# RABBITMQ_USER and RABBITMQ_PASSWORD from infrastructure/.env.
RABBITMQ_URL=amqp://solargrid:<RABBITMQ_PASSWORD>@localhost:5672

# Outbox publisher: how often pending events are retried, and how long a
# single publish may take before it is left for the next pass.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_PUBLISH_TIMEOUT_MS=5000

# HTTP platform (see docs/api-security.md)
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60

# How long a shutdown may wait for in-flight work before the process exits anyway.
SHUTDOWN_TIMEOUT_MS=25000
