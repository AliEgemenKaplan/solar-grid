datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Energy is stored as Decimal(12, 3): three decimals is one watt hour, finer
// than any household meter reports, and exact arithmetic keeps the numbers
// from drifting once they are multiplied by a price downstream.

model MeterReading {
  id             String       @id @default(cuid())
  householdId    String
  productionKwh  Decimal      @db.Decimal(12, 3)
  consumptionKwh Decimal      @db.Decimal(12, 3)
  netKwh         Decimal      @db.Decimal(12, 3)
  status         EnergyStatus
  timestamp      DateTime
  createdAt      DateTime     @default(now())

  // A meter reports one reading per household per timestamp. This index also
  // serves "readings for this household, newest first".
  @@unique([householdId, timestamp])
  @@map("meter_readings")
}

model HouseholdEnergyStatus {
  id                String       @id @default(cuid())
  householdId       String       @unique
  currentStatus     EnergyStatus
  currentSurplusKwh Decimal      @default(0) @db.Decimal(12, 3)
  currentDemandKwh  Decimal      @default(0) @db.Decimal(12, 3)
  /// Timestamp of the reading this status came from, so a reading that
  /// arrives late cannot overwrite a newer one.
  lastReadingAt     DateTime
  updatedAt         DateTime     @updatedAt

  @@map("household_energy_status")
}

/// Transactional outbox. An event is written in the same transaction as the
/// reading that caused it, so the two can never disagree: if the reading is
/// stored the event exists, and a publisher moves it to the broker afterwards.
model OutboxEvent {
  id            String       @id @default(cuid())
  eventId       String       @unique
  eventType     String
  routingKey    String
  payload       Json
  correlationId String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  // The publisher scans pending rows oldest first.
  @@index([status, createdAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
}

enum EnergyStatus {
  SURPLUS
  DEMAND
  BALANCED
}
