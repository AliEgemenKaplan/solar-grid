datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Energy is Decimal(12, 3), prices Decimal(10, 4) and money Decimal(14, 2).
// Reserving energy subtracts from a running balance over and over, which is
// precisely where binary floating point leaves dust behind.

model SellOffer {
  id            String       @id @default(cuid())
  householdId   String
  sourceEventId String?      @unique
  availableKwh  Decimal      @db.Decimal(12, 3)
  originalKwh   Decimal      @db.Decimal(12, 3)
  status        OfferStatus  @default(OPEN)
  correlationId String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  trades        TradeMatch[]

  // Matching scans open offers oldest first.
  @@index([status, createdAt])
  @@index([householdId])
  // Tracing one reading through to the offer or request it created.
  @@index([correlationId])
  @@map("sell_offers")
}

model BuyRequest {
  id            String        @id @default(cuid())
  householdId   String
  sourceEventId String?       @unique
  requestedKwh  Decimal       @db.Decimal(12, 3)
  originalKwh   Decimal       @db.Decimal(12, 3)
  status        RequestStatus @default(OPEN)
  correlationId String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trades        TradeMatch[]

  // Matching scans open requests oldest first.
  @@index([status, createdAt])
  @@index([householdId])
  // Tracing one reading through to the offer or request it created.
  @@index([correlationId])
  @@map("buy_requests")
}

model TradeMatch {
  id                String      @id @default(cuid())
  tradeId           String      @unique
  sellerHouseholdId String
  buyerHouseholdId  String
  energyKwh         Decimal     @db.Decimal(12, 3)
  pricePerKwh       Decimal     @db.Decimal(10, 4)
  totalAmount       Decimal     @db.Decimal(14, 2)
  currency          String
  status            TradeStatus @default(PENDING_BILLING)
  billingTradeId    String?
  /// The offer and request this trade reserved energy from. Needed to give
  /// the energy back if billing rejects the trade outright.
  offerId           String
  requestId         String
  idempotencyKey    String      @unique
  billingAttempts   Int         @default(0)
  correlationId     String
  failureReason     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // A trade cannot reserve energy from an offer or request that is not there.
  offer             SellOffer   @relation(fields: [offerId], references: [id])
  request           BuyRequest  @relation(fields: [requestId], references: [id])

  // Settlement picks up unconfirmed trades oldest first.
  @@index([status, createdAt])
  // Statistics read a window across every status, and household trading from
  // whichever side of the trade the household was on.
  @@index([createdAt])
  @@index([sellerHouseholdId])
  @@index([buyerHouseholdId])
  @@index([offerId])
  @@index([requestId])
  // Tracing one reading through to its trades.
  @@index([correlationId])
  @@map("trade_matches")
}

enum OfferStatus {
  OPEN
  PARTIALLY_MATCHED
  MATCHED
  CANCELLED
}

enum RequestStatus {
  OPEN
  PARTIALLY_MATCHED
  MATCHED
  CANCELLED
}

enum TradeStatus {
  /// Energy is reserved on the offer and request, billing outcome unknown.
  /// A trade may only leave this state once billing has given a definite
  /// answer, which is what stops the same energy being billed twice.
  PENDING_BILLING
  COMPLETED
  FAILED
}
