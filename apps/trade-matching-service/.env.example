NODE_ENV=development
PORT=3003
# The database is not published to the host by the base compose file.
# To run this service locally against the containerised database, start
# the stack with infrastructure/docker-compose.dev-ports.yml as well.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/matching_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
PRICING_ENGINE_URL=http://localhost:3002
BILLING_LEDGER_URL=http://localhost:3004

# Deadline for calls to pricing and billing. Without one, a hung call blocks
# the consumer channel and no further events are processed.
HTTP_CLIENT_TIMEOUT_MS=5000
