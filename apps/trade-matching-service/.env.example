NODE_ENV=development
PORT=3003
# The database is not published to the host by the base compose file.
# To run this service locally against the containerised database, start
# the stack with infrastructure/docker-compose.dev-ports.yml as well.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/matching_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
PRICING_ENGINE_URL=http://localhost:3002
BILLING_LEDGER_URL=http://localhost:3004

# Deadline for calls to pricing and billing. Without one, a hung call blocks
# the consumer channel and no further events are processed.
HTTP_CLIENT_TIMEOUT_MS=5000

# Messaging reliability. A failing message is retried this many times with a
# delay that doubles each attempt (2s, 4s, 8s by default) and is then parked in
# the dead letter queue. Changing the delay changes the TTL on the retry
# queues, and RabbitMQ refuses to redeclare a queue with different arguments -
# run `pnpm docker:clean` once after changing it.
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=2000
# Unacknowledged messages per consumer. Matching is serialised by a database
# lock, so a larger window buys throughput the matching step cannot use.
RABBITMQ_PREFETCH=1

# HTTP platform (see docs/api-security.md)
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
# Required by POST /matching/run.
OPERATOR_API_TOKEN=
# Sent to billing when recording a trade. Must match billing.
INTERNAL_API_TOKEN=
