{
  "name": "@solar-grid/trade-matching-service",
  "version": "1.0.0",
  "description": "Trade matching service: consumes energy events, matches buyers and sellers",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:integration": "jest --testRegex \".*\\.integration\\.spec\\.ts$\" --testPathIgnorePatterns \"/node_modules/\" --runInBand --passWithNoTests",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^5.10.0",
    "@solar-grid/shared-contracts": "workspace:*",
    "@solar-grid/shared-utils": "workspace:*",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.13.4",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@solar-grid/shared-contracts(.*)$": "<rootDir>/../../packages/shared-contracts/src$1",
      "^@solar-grid/shared-utils(.*)$": "<rootDir>/../../packages/shared-utils/src$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.spec\\.ts$"
    ]
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
