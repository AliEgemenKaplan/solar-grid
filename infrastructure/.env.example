# Configuration for infrastructure/docker-compose.yml.
#
#   pnpm env:init
#
# copies this file to infrastructure/.env and fills every empty secret below
# with a random value. It never overwrites a value that is already set, so it
# is also how an existing .env picks up newly added settings.
#
# infrastructure/.env is ignored by git. Never commit it.

# --- Secrets ------------------------------------------------------------------
# Required: docker compose refuses to start while any of these is empty, and a
# service running with NODE_ENV=production refuses a short or well-known value.
# Use URL-safe characters (the generated hex values are): the database and
# broker passwords are placed inside connection URLs.

# Owner of each database. Used only by PostgreSQL itself and the migration jobs.
POSTGRES_PASSWORD=

# The runtime role (solargrid_app) each service connects as, one per database,
# so a service holding one cannot log in to another service's database.
SMART_METER_DB_PASSWORD=
PRICING_DB_PASSWORD=
MATCHING_DB_PASSWORD=
LEDGER_DB_PASSWORD=

# RabbitMQ. The user is created when the broker's volume is first initialised.
RABBITMQ_USER=solargrid
RABBITMQ_PASSWORD=

# Bearer tokens (see docs/api-security.md). At least 32 characters, and all
# three must differ so the roles they grant can be told apart.
OPERATOR_API_TOKEN=
INTERNAL_API_TOKEN=
# Read-only access to GET /metrics on every service, for a metrics scraper.
METRICS_TOKEN=

# --- Host ports -----------------------------------------------------------------
# What docker-compose.yml binds on the host, always on 127.0.0.1. Change any
# value that collides with another stack running on your machine.
SMART_METER_PORT=3001
PRICING_PORT=3002
TRADE_MATCHING_PORT=3003
BILLING_PORT=3004
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Only used with docker-compose.dev-ports.yml, which publishes the databases
# on the loopback interface so a service can run on the host against them.
SMART_METER_DB_PORT=5433
PRICING_DB_PORT=5434
TRADE_MATCHING_DB_PORT=5435
BILLING_DB_PORT=5436

# --- HTTP platform ----------------------------------------------------------------
# Swagger UI at /api. Off by default because this stack runs with
# NODE_ENV=production; set to true to browse the API locally.
SWAGGER_ENABLED=false

# Browser origins allowed to call the API directly. Empty means same origin
# only. List origins explicitly; "*" is ignored.
CORS_ALLOWED_ORIGINS=

# Logs: json (one object per line) or pretty; and the least severe level
# written: fatal, error, warn, log, debug or verbose.
LOG_FORMAT=json
LOG_LEVEL=log

# Per client address, per route, per window.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
