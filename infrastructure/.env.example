# Host ports published by docker-compose.yml. Every service also listens on
# its own port inside the compose network; these only control what is bound
# on the host, and only on 127.0.0.1.
#
# Copy to infrastructure/.env and change any value that collides with
# another stack running on your machine.
SMART_METER_PORT=3001
PRICING_PORT=3002
TRADE_MATCHING_PORT=3003
BILLING_PORT=3004
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Only used with docker-compose.dev-ports.yml, which publishes the databases
# on the loopback interface so a service can run on the host against them.
SMART_METER_DB_PORT=5433
PRICING_DB_PORT=5434
TRADE_MATCHING_DB_PORT=5435
BILLING_DB_PORT=5436

# --- API security -----------------------------------------------------------
# Bearer tokens. The compose file falls back to development defaults that
# contain "not-for-production" and are flagged at startup; set real, long,
# random values for anything that is not your own machine, for example:
#   openssl rand -hex 32
# The two must differ, so operator calls and service calls can be told apart.
OPERATOR_API_TOKEN=
INTERNAL_API_TOKEN=

# Swagger UI at /api. Off by default because this stack runs with
# NODE_ENV=production; set to true to browse the API locally.
SWAGGER_ENABLED=false

# Browser origins allowed to call the API directly. Empty means same origin
# only. List origins explicitly; "*" is ignored.
CORS_ALLOWED_ORIGINS=

# Per client address, per route, per window.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
