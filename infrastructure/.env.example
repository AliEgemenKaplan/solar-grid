# Host ports published by docker-compose.yml. Every service also listens on
# its own port inside the compose network; these only control what is bound
# on the host, and only on 127.0.0.1.
#
# Copy to infrastructure/.env and change any value that collides with
# another stack running on your machine.
SMART_METER_PORT=3001
PRICING_PORT=3002
TRADE_MATCHING_PORT=3003
BILLING_PORT=3004
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Only used with docker-compose.dev-ports.yml, which publishes the databases
# on the loopback interface so a service can run on the host against them.
SMART_METER_DB_PORT=5433
PRICING_DB_PORT=5434
TRADE_MATCHING_DB_PORT=5435
BILLING_DB_PORT=5436
