{
  "name": "solar-grid",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Neighborhood-level peer-to-peer renewable energy trading platform",
  "scripts": {
    "build": "pnpm --filter @solar-grid/shared-contracts build && pnpm --filter @solar-grid/shared-utils build && pnpm --filter @solar-grid/nest-common build && pnpm -r --filter \"./apps/*\" build",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" test:integration",
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 exec tsc --noEmit -p tsconfig.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:dev": "docker compose -f infrastructure/docker-compose.yml up",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:clean": "docker compose -f infrastructure/docker-compose.yml down -v --remove-orphans",
    "prisma:generate": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" run prisma:generate",
    "prisma:deploy": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" prisma:deploy",
    "demo:sh": "bash scripts/demo.sh",
    "demo:ps": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
