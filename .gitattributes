# Normalise line endings: the repository always stores LF.
# Without this, core.autocrlf=true on Windows checks out CRLF and breaks
# shell scripts inside Linux containers and CI.
* text=auto eol=lf

*.sh   text eol=lf
*.ps1  text eol=crlf

# Generated / vendored files: keep diffs quiet
pnpm-lock.yaml linguist-generated=true -diff

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
